# Megregore Configuration
# Copy this file to `.env` and adjust values as needed.

# Server Configuration
# ====================
# Bind address for uvicorn server
# Default: 127.0.0.1 (localhost only)
# Set to 0.0.0.0 for remote access (use with reverse proxy + HTTPS)
MEGREGORE_HOST=127.0.0.1

# Bind port for uvicorn server
# Default: 3000
MEGREGORE_PORT=3000

# Security Configuration
# ======================
# JWT secret key for token signing
# If not set, a key is auto-generated and stored in data/.secret
# MEGREGORE_SECRET=your-very-secure-random-secret-key-here

# CORS Configuration
# ==================
# Comma-separated list of allowed CORS origins
# Default: http://localhost:3000
MEGREGORE_CORS_ORIGINS=http://localhost:3000

# JWT Configuration
# =================
# JWT token lifetime in hours
# Default: 24
MEGREGORE_TOKEN_EXPIRY_HOURS=24

# Rate Limiting
# =============
# Maximum requests per minute per IP address
# Default: 60
MEGREGORE_RATE_LIMIT=60

# Proxy / Production
# ===================
# Set to true if running behind a reverse proxy (Nginx, Caddy)
# Enables X-Forwarded-For header parsing for real client IPs
# Default: false
MEGREGORE_TRUSTED_PROXY=false

# Set to true when serving over HTTPS (production/VPS)
# Enables HSTS headers and Secure cookie flag
# Default: false
MEGREGORE_SECURE=false

# Admin Configuration
# ===================
# The admin username for login
# Default: admin
MEGREGORE_ADMIN_USERNAME=admin
